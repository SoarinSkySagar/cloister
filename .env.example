# Copy to .env (gitignored). Testnet-only keys. Never commit real values.
QORE_NETWORK=testnet
# Rollup creator / sequencer operator (holds the stake; NOT the Q-Day Drill account)
QORE_MNEMONIC=
# Optional: explicit ML-DSA-87 seed (hex) if not derived from the mnemonic
QORE_PQC_SEED_HEX=
# Member ML-KEM-1024 seed (64-byte hex, d||z) for the sequencer
CLOISTER_KEM_SEED_HEX=
# Watchtower member keys
WATCHTOWER_MNEMONIC=
WATCHTOWER_KEM_SEED_HEX=
# Relayer account
RELAYER_MNEMONIC=
# Rollup id in use (dev cycles: cloister-dev-N; final: cloister)
CLOISTER_ROLLUP_ID=cloister-dev-1
# Optional alert webhook (Discord/Telegram)
ALERT_WEBHOOK_URL=
