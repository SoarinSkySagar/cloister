{
  "name": "@cloister/receipts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:web": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=web/app.js",
    "start": "pnpm build:web && tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@qorechain/rdk": "0.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
